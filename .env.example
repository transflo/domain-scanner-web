# ---- 必填 ----
# Web UI 登录口令(至少 8 位)。口令保护是强制的:缺失或过短时服务拒绝启动,docker compose 也会直接报错。
ADMIN_PASSWORD=

# ---- Telegram 通知(可选,也可在 Web UI 的"设置"页填写,设置页优先)----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- Cloudflare Registrar(可选,也可在"设置"页填写)----
# 命中的域名会先经 Cloudflare 的 domain-check 做最终确认,确认可注册才推送,并带「注册」按钮。
# Token 具有注册(扣费)能力:请只授予 Registrar 权限,并妥善保管。
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# ---- 网络与并发 ----
# Web UI 对外端口(默认 3000)与绑定地址。只想本机访问:WEB_BIND=127.0.0.1
WEB_PORT=3000
WEB_BIND=0.0.0.0
# 走代理的任务同时运行的上限(0 = 不限制)。直连任务永远不受限。
MAX_PARALLEL_JOBS=0
# 额外的 RDAP 服务器,格式 tld=https://rdap.example/ ,多个用逗号分隔。
# 内置已验证的 li ch de nl fr cz pl io ai sh ac cc;其余 TLD 走 IANA bootstrap,再不行回退 WHOIS。
RDAP_SERVERS=

# ---- 日志 ----
# docker compose logs 打印的最低级别(debug/info/warn/error)。数据库里保存的级别在"设置"页调整。
LOG_STDOUT_LEVEL=info
