# ---- 必填 ----
# Web UI 登录口令(至少 8 位)。口令保护是强制的:缺失或过短时服务拒绝启动,docker compose 也会直接报错。
ADMIN_PASSWORD=

# ---- 可选 ----
# Telegram 通知。也可以启动后在 Web UI 的"设置"页填写(设置页的值优先于这里)。
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Web UI 对外端口(默认 3000)
WEB_PORT=3000
# 同时运行的任务数(默认 2)
MAX_PARALLEL_JOBS=2
# 额外的 RDAP 服务器,格式 tld=https://rdap.example/ ,多个用逗号分隔。
# 内置已验证的 li ch de nl fr cz pl io ai sh ac cc;其余 TLD 走 IANA bootstrap,再不行回退 WHOIS。
RDAP_SERVERS=
