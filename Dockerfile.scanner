FROM golang:1.26 AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/scanner ./cmd/server

FROM alpine:3.21
RUN apk add --no-cache ca-certificates wget tzdata \
 && addgroup -S app && adduser -S app -G app
WORKDIR /app
# Built-in dictionaries (popular open-source word lists) are baked into the image.
COPY scripts/fetch-wordlists.sh /tmp/fetch-wordlists.sh
RUN sed -i 's/\r$//' /tmp/fetch-wordlists.sh && sh /tmp/fetch-wordlists.sh /app/wordlists && rm -f /tmp/fetch-wordlists.sh
COPY --from=build /out/scanner /app/scanner
RUN mkdir -p /data && chown app:app /data
USER app
ENV DATA_DIR=/data WORDLIST_DIR=/app/wordlists LISTEN_ADDR=:8080
VOLUME /data
EXPOSE 8080
HEALTHCHECK --interval=10s --timeout=3s --start-period=15s --retries=5 \
  CMD wget -qO- http://127.0.0.1:8080/api/health || exit 1
ENTRYPOINT ["/app/scanner"]
